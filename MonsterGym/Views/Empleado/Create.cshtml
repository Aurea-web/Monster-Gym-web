@model MonsterGym.Models.Empleado

@{
    ViewData["Title"] = "Nuevo Empleado";
}

<h1>Nuevo Empleado</h1>

<form asp-action="Create" method="post">
    <div class="mt-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="Apellido" class="form-label"></label>
        <input asp-for="Apellido" class="form-control" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="Documento" class="form-label"></label>
        <input asp-for="Documento" class="form-control" />
        <span asp-validation-for="Documento" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="Telefono" class="form-label"></label>
        <input asp-for="Telefono" class="form-control" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="Contrasena" class="form-label"></label>
        <input asp-for="Contrasena" type="password" class="form-control" />
        <span asp-validation-for="Contrasena" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="CargoId" class="form-label"></label>
     <select asp-for="CargoId" asp-items="ViewBag.Cargos" class="form-select">
    <option value="">Seleccione un cargo</option>
</select>
        <span asp-validation-for="CargoId" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="Activo" class="form-label"></label>
        <div class="form-check"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label"></label></div>
        <span asp-validation-for="Activo" class="text-danger"></span>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
