@model IEnumerable<MonsterGym.Models.Empleado>
@{
    ViewData["Title"] = "Empleados";
    var estado = (string?)ViewBag.Estado ?? "activos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Empleados</h1>
    <a asp-action="Create" class="btn btn-primary">Agregar Empleado</a>
</div>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <span class="fw-semibold">Mostrar:</span>
    <div class="btn-group">
        <a asp-action="Index" asp-route-estado="activos" class="btn @(estado == "activos" ? "btn-primary" : "btn-outline-primary")">Activos</a>
        <a asp-action="Index" asp-route-estado="todos" class="btn @(estado == "todos" ? "btn-primary" : "btn-outline-primary")">Todos</a>
        <a asp-action="Index" asp-route-estado="inactivos" class="btn @(estado == "inactivos" ? "btn-primary" : "btn-outline-primary")">Inactivos</a>
    </div>
</div>
<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
<thead><tr><th>Id</th><th>Nombre</th><th>Apellido</th><th>Documento</th><th>Telefono</th><th>Correo</th><th>Cargo</th><th>Activo</th><th>Acciones</th></tr></thead>
<tbody>
@foreach (var item in Model) {
<tr><td>@item.Id</td><td>@item.Nombre</td><td>@item.Apellido</td><td>@item.Documento</td><td>@item.Telefono</td><td>@item.Correo</td><td>@item.Cargo?.Nombre</td><td>@item.Activo</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a></td></tr>
}
</tbody></table></div>
