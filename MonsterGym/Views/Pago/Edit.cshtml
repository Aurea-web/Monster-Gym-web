@model MonsterGym.Models.Pago

@{
    ViewData["Title"] = "Editar Pago";
}

<h1>Editar Pago</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mt-3">
        <label asp-for="ContratoId" class="form-label"></label>
        <input asp-for="ContratoId" type="number" class="form-control" />
        <span asp-validation-for="ContratoId" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="Monto" class="form-label"></label>
        <input asp-for="Monto" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Monto" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="MetodoPago" class="form-label"></label>
        <input asp-for="MetodoPago" class="form-control" />
        <span asp-validation-for="MetodoPago" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="FechaPago" class="form-label"></label>
        <input asp-for="FechaPago" type="datetime-local" class="form-control" />
        <span asp-validation-for="FechaPago" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="Comprobante" class="form-label"></label>
        <input asp-for="Comprobante" class="form-control" />
        <span asp-validation-for="Comprobante" class="text-danger"></span>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
