@model IEnumerable<MonsterGym.Models.Membresia>
@{
    ViewData["Title"] = "Membresías";
    var estado = (string?)ViewBag.Estado ?? "activos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Membresías</h1>
    <a asp-action="Create" class="btn btn-primary">Agregar Membresia</a>
</div>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <span class="fw-semibold">Mostrar:</span>
    <div class="btn-group">
        <a asp-action="Index" asp-route-estado="activos" class="btn @(estado == "activos" ? "btn-primary" : "btn-outline-primary")">Activas</a>
        <a asp-action="Index" asp-route-estado="todos" class="btn @(estado == "todos" ? "btn-primary" : "btn-outline-primary")">Todas</a>
        <a asp-action="Index" asp-route-estado="inactivos" class="btn @(estado == "inactivos" ? "btn-primary" : "btn-outline-primary")">Inactivas</a>
    </div>
</div>
<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
<thead><tr><th>Id</th><th>Nombre</th><th>Precio</th><th>DiasVigencia</th><th>Beneficios</th><th>Activa</th><th>Acciones</th></tr></thead>
<tbody>
@foreach (var item in Model) {
<tr><td>@item.Id</td><td>@item.Nombre</td><td>@item.Precio</td><td>@item.DiasVigencia</td><td>@item.Beneficios</td><td>@item.Activa</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a></td></tr>
}
</tbody></table></div>
