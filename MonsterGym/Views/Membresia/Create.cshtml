@model MonsterGym.Models.Membresia

@{
    ViewData["Title"] = "Nuevo Membresia";
}

<h1>Nuevo Membresia</h1>

<form asp-action="Create" method="post">
    <div class="mt-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="Precio" class="form-label"></label>
        <input asp-for="Precio" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="DiasVigencia" class="form-label"></label>
        <input asp-for="DiasVigencia" type="number" class="form-control" />
        <span asp-validation-for="DiasVigencia" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="Beneficios" class="form-label"></label>
        <textarea asp-for="Beneficios" class="form-control"></textarea>
        <span asp-validation-for="Beneficios" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="Activa" class="form-label"></label>
        <div class="form-check"><input asp-for="Activa" class="form-check-input" /><label asp-for="Activa" class="form-check-label"></label></div>
        <span asp-validation-for="Activa" class="text-danger"></span>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
