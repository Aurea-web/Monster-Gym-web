@model MonsterGym.Models.Contrato

@{
    ViewData["Title"] = "Nuevo Contrato";
}

<h1>Nuevo Contrato</h1>

<form asp-action="Create" method="post">
    <div class="mt-3">
        <label asp-for="ClienteId" class="form-label"></label>
        <input asp-for="ClienteId" type="number" class="form-control" />
        <span asp-validation-for="ClienteId" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="MembresiaId" class="form-label"></label>
        <input asp-for="MembresiaId" type="number" class="form-control" />
        <span asp-validation-for="MembresiaId" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="FechaInicio" class="form-label"></label>
        <input asp-for="FechaInicio" type="datetime-local" class="form-control" />
        <span asp-validation-for="FechaInicio" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="FechaVencimiento" class="form-label"></label>
        <input asp-for="FechaVencimiento" type="datetime-local" class="form-control" />
        <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="Activo" class="form-label"></label>
        <div class="form-check"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label"></label></div>
        <span asp-validation-for="Activo" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label asp-for="Congelado" class="form-label"></label>
        <div class="form-check"><input asp-for="Congelado" class="form-check-input" /><label asp-for="Congelado" class="form-check-label"></label></div>
        <span asp-validation-for="Congelado" class="text-danger"></span>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
