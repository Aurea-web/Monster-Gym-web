@model IEnumerable<MonsterGym.Models.Contrato>

@{
    ViewData["Title"] = "Contratos";
    var estado = (string?)ViewBag.Estado ?? "activos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Contratos</h1>
    <a asp-action="Create" class="btn btn-primary">Agregar Contrato</a>
</div>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <span class="fw-semibold">Mostrar:</span>
    <div class="btn-group" role="group" aria-label="Filtro de contratos">
        <a asp-action="Index" asp-route-estado="activos"
           class="btn @(estado == "activos" ? "btn-primary" : "btn-outline-primary")">Activos</a>
        <a asp-action="Index" asp-route-estado="todos"
           class="btn @(estado == "todos" ? "btn-primary" : "btn-outline-primary")">Todos</a>
        <a asp-action="Index" asp-route-estado="inactivos"
           class="btn @(estado == "inactivos" ? "btn-primary" : "btn-outline-primary")">Inactivos</a>
    </div>
</div>

<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead><tr>
        <th>Id</th>
        <th>Nombre</th>
        <th>Membresia</th>
        <th>FechaInicio</th>
        <th>FechaVencimiento</th>
        <th>Activo</th>
        <th>Congelado</th>
        <th>Acciones</th>
    </tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Cliente?.Nombre</td>
            <td>@item.Membresia?.Nombre</td>
            <td>@item.FechaInicio</td>
            <td>@item.FechaVencimiento</td>
            <td>@item.Activo</td>
            <td>@item.Congelado</td>
            <td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a></td>
        </tr>
    }
    </tbody>
</table>
</div>
