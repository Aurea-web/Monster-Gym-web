@model IEnumerable<MonsterGym.Models.Contrato>

@{
    ViewData["Title"] = "Contratos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Contratos</h1>
    <a asp-action="Create" class="btn btn-primary">Agregar Contrato</a>
</div>

<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead><tr>
        <th>Id</th>
        <th>ClienteId</th>
        <th>MembresiaId</th>
        <th>FechaInicio</th>
        <th>FechaVencimiento</th>
        <th>Activo</th>
        <th>Congelado</th>
        <th>Acciones</th>
    </tr></thead><tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.ClienteId</td>
            <td>@item.MembresiaId</td>
            <td>@item.FechaInicio</td>
            <td>@item.FechaVencimiento</td>
            <td>@item.Activo</td>
            <td>@item.Congelado</td>
            <td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a></td>
        </tr>
    }
</tbody></table></div>
