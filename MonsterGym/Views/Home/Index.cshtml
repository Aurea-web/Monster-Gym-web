@using MonsterGym.Models
@{
    ViewData["Title"] = "MonsterGym";
    var clientes = (IEnumerable<Cliente>)ViewBag.Clientes;
    var membresias = (IEnumerable<Membresia>)ViewBag.Membresias;
    var contratos = (IEnumerable<Contrato>)ViewBag.Contratos;
    var empleados = (IEnumerable<Empleado>)ViewBag.Empleados;
    var cargos = (IEnumerable<Cargo>)ViewBag.Cargos;
    var pagos = (IEnumerable<Pago>)ViewBag.Pagos;
}

<div class="text-center mb-5">
    <h1 class="display-4 fw-bold">MonsterGym</h1>
    <p class="lead">Panel principal de gestión</p>
</div>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-2"><h2>Clientes</h2><a class="btn btn-sm btn-primary" asp-controller="Cliente" asp-action="Create">Agregar</a></div>
    <div class="table-responsive"><table class="table table-striped table-bordered align-middle"><thead><tr>
        <th>Id</th><th>Nombre</th><th>Apellido</th><th>Documento</th><th>Telefono</th><th>Correo</th><th>ContactoEmergencia</th><th>Activo</th><th>Acciones</th>
    </tr></thead><tbody>
    @foreach (var item in clientes) { <tr><td>@item.Id</td><td>@item.Nombre</td><td>@item.Apellido</td><td>@item.Documento</td><td>@item.Telefono</td><td>@item.Correo</td><td>@item.ContactoEmergencia</td><td>@item.Activo</td><td><a class="btn btn-sm btn-outline-primary" asp-controller="Cliente" asp-action="Edit" asp-route-id="@item.Id">Editar</a></td></tr> }
    </tbody></table></div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-2"><h2>Membresías</h2><a class="btn btn-sm btn-primary" asp-controller="Membresia" asp-action="Create">Agregar</a></div>
    <div class="table-responsive"><table class="table table-striped table-bordered align-middle"><thead><tr>
        <th>Id</th><th>Nombre</th><th>Precio</th><th>DiasVigencia</th><th>Beneficios</th><th>Activa</th><th>Acciones</th>
    </tr></thead><tbody>
    @foreach (var item in membresias) { <tr><td>@item.Id</td><td>@item.Nombre</td><td>@item.Precio</td><td>@item.DiasVigencia</td><td>@item.Beneficios</td><td>@item.Activa</td><td><a class="btn btn-sm btn-outline-primary" asp-controller="Membresia" asp-action="Edit" asp-route-id="@item.Id">Editar</a></td></tr> }
    </tbody></table></div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-2"><h2>Contratos</h2><a class="btn btn-sm btn-primary" asp-controller="Contrato" asp-action="Create">Agregar</a></div>
    <div class="table-responsive"><table class="table table-striped table-bordered align-middle"><thead><tr>
        <th>Id</th><th>ClienteId</th><th>MembresiaId</th><th>FechaInicio</th><th>FechaVencimiento</th><th>Activo</th><th>Congelado</th><th>Acciones</th>
    </tr></thead><tbody>
    @foreach (var item in contratos) { <tr><td>@item.Id</td><td>@item.ClienteId</td><td>@item.MembresiaId</td><td>@item.FechaInicio</td><td>@item.FechaVencimiento</td><td>@item.Activo</td><td>@item.Congelado</td><td><a class="btn btn-sm btn-outline-primary" asp-controller="Contrato" asp-action="Edit" asp-route-id="@item.Id">Editar</a></td></tr> }
    </tbody></table></div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-2"><h2>Empleados</h2><a class="btn btn-sm btn-primary" asp-controller="Empleado" asp-action="Create">Agregar</a></div>
    <div class="table-responsive"><table class="table table-striped table-bordered align-middle"><thead><tr>
        <th>Id</th><th>Nombre</th><th>Apellido</th><th>Documento</th><th>Telefono</th><th>Correo</th><th>CargoId</th><th>Activo</th><th>Acciones</th>
    </tr></thead><tbody>
    @foreach (var item in empleados) { <tr><td>@item.Id</td><td>@item.Nombre</td><td>@item.Apellido</td><td>@item.Documento</td><td>@item.Telefono</td><td>@item.Correo</td><td>@item.CargoId</td><td>@item.Activo</td><td><a class="btn btn-sm btn-outline-primary" asp-controller="Empleado" asp-action="Edit" asp-route-id="@item.Id">Editar</a></td></tr> }
    </tbody></table></div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-2"><h2>Cargos</h2><a class="btn btn-sm btn-primary" asp-controller="Cargo" asp-action="Create">Agregar</a></div>
    <div class="table-responsive"><table class="table table-striped table-bordered align-middle"><thead><tr>
        <th>Id</th><th>Nombre</th><th>Descripcion</th><th>Acciones</th>
    </tr></thead><tbody>
    @foreach (var item in cargos) { <tr><td>@item.Id</td><td>@item.Nombre</td><td>@item.Descripcion</td><td><a class="btn btn-sm btn-outline-primary" asp-controller="Cargo" asp-action="Edit" asp-route-id="@item.Id">Editar</a></td></tr> }
    </tbody></table></div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-2"><h2>Pagos</h2><a class="btn btn-sm btn-primary" asp-controller="Pago" asp-action="Create">Agregar</a></div>
    <div class="table-responsive"><table class="table table-striped table-bordered align-middle"><thead><tr>
        <th>Id</th><th>ContratoId</th><th>Monto</th><th>MetodoPago</th><th>FechaPago</th><th>Comprobante</th><th>Acciones</th>
    </tr></thead><tbody>
    @foreach (var item in pagos) { <tr><td>@item.Id</td><td>@item.ContratoId</td><td>@item.Monto</td><td>@item.MetodoPago</td><td>@item.FechaPago</td><td>@item.Comprobante</td><td><a class="btn btn-sm btn-outline-primary" asp-controller="Pago" asp-action="Edit" asp-route-id="@item.Id">Editar</a></td></tr> }
    </tbody></table></div>
</section>
