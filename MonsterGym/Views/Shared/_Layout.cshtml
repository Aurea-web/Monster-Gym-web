<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MonsterGym</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/MonsterGym.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Barra.css" />
</head>
<body>

    <!-- Menú Lateral Vertical (Sidebar) -->
    <aside class="sidebar">
        <a class="sidebar-brand text-center" asp-controller="Home" asp-action="Index">MonsterGym</a>
        <ul class="nav nav-pills flex-column mt-3 mb-auto">
            @if (User.IsInRole(Rol.Cliente))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="MiCuenta" asp-action="Index">Mi cuenta</a>
                </li>
            }
            @if (User.IsInRole(Rol.Administrador) || User.IsInRole(Rol.Recepcionista))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Cliente" asp-action="Index">Clientes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Membresia" asp-action="Index">Membresías</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Contrato" asp-action="Index">Contratos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Pago" asp-action="Index">Pagos</a>
                </li>
            }
            @if (User.IsInRole(Rol.Administrador))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Empleado" asp-action="Index">Empleados</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Cargo" asp-action="Index">Cargos</a>
                </li>
            }
        </ul>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="p-3 border-top border-secondary small">
                <div class="fw-semibold">@User.Identity.Name</div>
                <div class="text-secondary mb-2">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                <form asp-controller="Cuenta" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-light w-100">Cerrar sesión</button>
                </form>
            </div>
        }
    </aside>

    <!-- Contenido del módulo y pie de página -->
    <div class="main-wrapper">
        <main role="main" class="main-content">
            @RenderBody()
        </main>

        <footer class="border-top footer text-muted py-3">
            <div class="container-fluid text-center">&copy; 2026 - MonsterGym</div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>